# Copy to a private file (never commit it) and pass it to the container with --env-file.
GOOGLE_API_KEY=        # Google Cloud key with Civic Information API + Fact Check Tools API enabled
FEC_API_KEY=           # https://api.data.gov/signup (DEMO_KEY works for a quick try)
OPENSTATES_API_KEY=    # https://open.pluralpolicy.com
